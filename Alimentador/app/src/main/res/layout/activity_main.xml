<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alimentador Felino"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A1C1E"
            android:layout_marginBottom="16dp" />

        <!-- 1. Panel de Control (Dashboard) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PANEL DE CONTROL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#6C757D" />

            <TextView
                android:id="@+id/tvEstadoWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: Conectando..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvPesoPlato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peso actual en plato: 0g"
                android:textSize="18sp"
                android:textColor="#1A1C1E"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvEstadoTolva"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tolva: Nivel normal"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnDispensarAhora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dispensar porción ahora"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- 2. Rutinas Nutricionales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RUTINAS PROGRAMADAS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#6C757D" />

            <Button
                android:id="@+id/btnNuevaRutina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Agregar horario y gramos"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvSinRutinas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay rutinas programadas todavía."
                android:textSize="15sp"
                android:textColor="#666666"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:id="@+id/llContenedorRutinas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 3. Registro Histórico (Logs) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTRO HISTÓRICO (LOGS)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#6C757D" />

            <TextView
                android:id="@+id/tvSinLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aún no hay eventos registrados."
                android:textSize="15sp"
                android:textColor="#666666"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:id="@+id/llContenedorLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>